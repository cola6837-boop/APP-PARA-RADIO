name: Compilar APK Elantra
on:
  workflow_dispatch:
  push:
    branches: [principal, main]
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Preparar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Instalar Android SDK
        uses: android-actions/setup-android@v3
      - name: Instalar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.10.2'
      - name: Extraer proyecto
        shell: bash
        run: |
          set -euo pipefail
          ZIP=$(find . -maxdepth 1 -type f -name 'ElantraMinimalUI_Premium_Android.zip' -print -quit)
          test -n "$ZIP" || { echo 'Falta ElantraMinimalUI_Premium_Android.zip en la raiz'; exit 1; }
          mkdir -p project
          unzip -q "$ZIP" -d project
          test -f project/settings.gradle || { echo 'No existe settings.gradle'; exit 1; }
      - name: Compilar APK Debug
        run: gradle -p project :app:assembleDebug --no-daemon
      - name: Publicar APK
        uses: actions/upload-artifact@v4
        with:
          name: Elantra-Minimal-UI-APK
          path: project/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
